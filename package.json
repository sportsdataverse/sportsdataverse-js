{
  "name": "sportsdataverse",
  "version": "4.0.0",
  "type": "module",
  "description": "Node.js client which retrieves sports data from the ESPN API as well as from the NCAA website, with support for NBA, NFL, NHL, MLB, WNBA, men's and women's college basketball, and college football.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "parsers": [
        "./dist/parsers/index.d.ts"
      ]
    }
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@tidyjs/tidy": "^2.6.1",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "papaparse": "^5.7.0",
    "tabletojson": "^4.1.15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "impit": "^0.14.5",
    "mocha": "^12.0.3",
    "publint": "^0.3.25",
    "should": "^13.2.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "impit": ">=0.14.0 <1",
    "playwright": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "impit": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "c8 mocha --timeout 15000 \"test/**/*.test.js\"",
    "docs": "typedoc",
    "codegen": "node tools/codegen/generate.mjs",
    "codegen:check": "node tools/codegen/generate.mjs --check",
    "schemas:captures": "node tools/codegen/regen-capture-schemas.mjs",
    "schemas:captures:check": "node tools/codegen/regen-capture-schemas.mjs --check",
    "vendor": "node tools/codegen/vendor.mjs",
    "vendor:check": "node tools/codegen/vendor.mjs --check",
    "api:report": "tsc && node tools/api-report.mjs",
    "api:check": "tsc && node tools/api-report.mjs --check",
    "pack:check": "node tools/pack-check.mjs",
    "vendor:check:online": "node tools/codegen/vendor-lock-online.mjs",
    "bundle:parsers": "esbuild src/parsers/browser.ts --bundle --format=esm --platform=browser --legal-comments=eof --outfile=docs/src/playground/parsers.bundle.mjs",
    "docs:examples": "node tools/docs/inject-outputs.mjs",
    "docs:examples:check": "node tools/docs/inject-outputs.mjs --check",
    "coverage:generated": "c8 report --include=\"dist/generated/**\" --exclude=\"\" --check-coverage=false --reporter=text-summary"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sportsdataverse/sportsdataverse-js.git"
  },
  "keywords": [
    "sports",
    "nba",
    "nfl",
    "nhl",
    "mlb",
    "wnba",
    "cbb",
    "wbb",
    "ncaa",
    "espn",
    "basketball",
    "hoops",
    "college-basketball",
    "water-polo-men",
    "water-polo-women",
    "men's-water-polo",
    "women's-water-polo",
    "basketball",
    "ncaa-w",
    "basketball-men",
    "basketball-women",
    "mens-basketball",
    "women's-basketball",
    "men's-soccer",
    "women's-soccer",
    "soccer-men",
    "soccer-women",
    "mens-ice-hockey",
    "women's-ice-hockey",
    "field-hockey",
    "men's-ice-hockey",
    "women's-ice-hockey",
    "ice-hockey-men",
    "ice-hockey-women",
    "baseball",
    "softball",
    "men's-volleyball",
    "women's-volleyball",
    "volleyball-men",
    "volleyball-women",
    "beach-volleyball",
    "women's-beach-volleyball",
    "men's-lacrosse",
    "women's-lacrosse",
    "lacrosse-men",
    "lacrosse-women",
    "men's-tennis",
    "women's-tennis",
    "tennis-men",
    "tennis-women",
    "women's-bowling",
    "bowling-women",
    "statistics",
    "football",
    "college football",
    "mbb",
    "mfb",
    "mih",
    "mlh",
    "mso",
    "mte",
    "mvb",
    "mwp",
    "wbb",
    "wbw",
    "wfh",
    "wih",
    "wla",
    "wsb",
    "wso",
    "wsv",
    "wte",
    "wvb",
    "wwp",
    "cfb",
    "ncaaf",
    "ncaam"
  ],
  "author": "Saiem Gilani",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sportsdataverse/sportsdataverse-js/issues"
  },
  "homepage": "https://js.sportsdataverse.org/",
  "engines": {
    "node": ">=20.18.1"
  }
}
