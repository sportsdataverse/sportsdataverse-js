{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true
  },
  /* Strict ratchet (T18b-2), one directory at a time. A root file pulls in
     everything it imports, so a directory is listed only once its whole import
     graph passes. Still out: src/services/* (legacy hand-written ESPN methods)
     and src/index.ts + src/discover.ts, which import them. */
  "include": [
    "src/analytics",
    "src/core",
    "src/generated",
    "src/leagues",
    "src/models",
    "src/odds",
    "src/parsers",
    "src/producers"
  ]
}
